{
  "name": "tenant-trust",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "chaincode/*"
  ],
  "scripts": {
    "check:environment": "node scripts/check-environment.mjs",
    "infra:init": "node scripts/init-local-env.mjs",
    "infra:up": "docker compose --env-file .env -f infra/compose/compose.yaml up -d postgres redis nats step-ca opa",
    "infra:migrate": "docker compose --env-file .env -f infra/compose/compose.yaml --profile tools run --rm migrate",
    "infra:check": "node scripts/check-core-services.mjs",
    "infra:down": "docker compose --env-file .env -f infra/compose/compose.yaml down",
    "pki:init": "docker compose --env-file .env -f infra/compose/compose.yaml --profile tools run --rm step-ca-init",
    "policy:test": "docker compose --env-file .env -f infra/compose/compose.yaml --profile tools run --rm opa-test",
    "security-services:verify": "node scripts/verify-security-services.mjs",
    "messaging:verify": "node scripts/verify-event-delivery.mjs",
    "runtime-isolation:verify": "node scripts/verify-runtime-isolation.mjs",
    "identity-model:verify": "node scripts/verify-identity-model.mjs",
    "demo:provision": "node scripts/provision-demo-identities.mjs",
    "demo:verify": "node scripts/verify-demo-provisioning.mjs",
    "database-isolation:verify": "node scripts/verify-database-isolation.mjs",
    "resource-membership:verify": "node scripts/verify-resource-membership-isolation.mjs",
    "security-configuration:verify": "node scripts/verify-security-configuration.mjs",
    "cross-tenant:verify": "node scripts/verify-cross-tenant-tampering.mjs",
    "tenant-lifecycle:verify": "node scripts/verify-tenant-lifecycle.mjs",
    "tenant-isolation:verify": "node scripts/verify-tenant-isolation-phase.mjs",
    "foundation:check": "node scripts/verify-foundation.mjs",
    "foundation:clean": "node scripts/verify-clean-foundation.mjs",
    "test:contracts": "node --test packages/contracts/test/*.test.mjs",
    "test:messaging": "npm test --workspace @tenant-trust/messaging",
    "test:tenant-context": "npm test --workspace @tenant-trust/tenant-context",
    "test": "npm run test:contracts && npm run test:messaging && npm run test:tenant-context"
  },
  "engines": {
    "node": "24.20.0",
    "npm": ">=10.8.3"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
