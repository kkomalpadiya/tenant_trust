{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenant-trust.local/contracts/events/tenant-event.schema.json",
  "title": "Tenant lifecycle event",
  "type": "object",
  "allOf": [
    { "$ref": "../common.schema.json#/$defs/eventEnvelope" },
    {
      "type": "object",
      "properties": {
        "eventType": { "enum": ["tenant.created.v1", "tenant.suspended.v1", "tenant.reactivated.v1"] },
        "subjectId": { "type": "null" },
        "aggregateId": { "$ref": "../common.schema.json#/$defs/tenantId" },
        "payload": {
          "type": "object",
          "properties": {
            "state": { "enum": ["active", "suspended"] },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
            "reasonCode": { "$ref": "../common.schema.json#/$defs/reasonCode" }
          },
          "required": ["state", "displayName"],
          "additionalProperties": false
        }
      },
      "required": ["payload"]
    }
  ]
}
