{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenant-trust.local/contracts/pki/certificate-request.schema.json",
  "title": "Normalized tenant certificate request",
  "description": "Internal certificate request after authentication and trusted tenant-context resolution.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "../common.schema.json#/$defs/requestId"
    },
    "profileId": {
      "const": "tenant-client-auth-v1"
    },
    "operation": {
      "enum": [
        "issue",
        "renew"
      ]
    },
    "tenantId": {
      "$ref": "../common.schema.json#/$defs/tenantId"
    },
    "subjectId": {
      "$ref": "../common.schema.json#/$defs/subjectId"
    },
    "requestedBySubjectId": {
      "$ref": "../common.schema.json#/$defs/subjectId"
    },
    "requestedAt": {
      "$ref": "../common.schema.json#/$defs/rfc3339Utc"
    },
    "requestedValiditySeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 86400,
      "default": 3600
    },
    "proofOfPossession": {
      "type": "object",
      "properties": {
        "publicKeyAlgorithm": {
          "enum": [
            "ecdsa-p256",
            "ed25519"
          ]
        },
        "csrPem": {
          "type": "string",
          "minLength": 80,
          "maxLength": 8192,
          "pattern": "^-----BEGIN CERTIFICATE REQUEST-----[\\s\\S]+-----END CERTIFICATE REQUEST-----\\r?\\n?$"
        },
        "csrSha256": {
          "$ref": "../common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "publicKeyAlgorithm",
        "csrPem",
        "csrSha256"
      ],
      "additionalProperties": false
    },
    "renewalOfCertificateId": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/certificateId"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotencyKey": {
      "$ref": "../common.schema.json#/$defs/idempotencyKey"
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "profileId",
    "operation",
    "tenantId",
    "subjectId",
    "requestedBySubjectId",
    "requestedAt",
    "requestedValiditySeconds",
    "proofOfPossession",
    "renewalOfCertificateId",
    "idempotencyKey"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "issue"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "renewalOfCertificateId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "renew"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "renewalOfCertificateId": {
            "$ref": "../common.schema.json#/$defs/certificateId"
          }
        }
      }
    }
  ]
}
