{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenant-trust.local/contracts/evidence/signed-evidence-envelope.schema.json",
  "title": "Signed evidence envelope",
  "description": "A source-authenticated evidence observation submitted to the evidence-ingestion boundary.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventId": { "$ref": "../common.schema.json#/$defs/eventId" },
    "tenantId": { "$ref": "../common.schema.json#/$defs/tenantId" },
    "subjectId": { "$ref": "../common.schema.json#/$defs/subjectId" },
    "sourceId": { "$ref": "../common.schema.json#/$defs/sourceId" },
    "evidenceType": {
      "enum": ["identity", "device", "behaviour", "certificate", "compliance"]
    },
    "observedAt": { "$ref": "../common.schema.json#/$defs/rfc3339Utc" },
    "expiresAt": { "$ref": "../common.schema.json#/$defs/rfc3339Utc" },
    "sourceSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonce": {
      "type": "string",
      "description": "Unpadded base64url entropy unique within the source key epoch.",
      "pattern": "^[A-Za-z0-9_-]{22,64}$"
    },
    "synthetic": { "type": "boolean" },
    "payload": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "canonicalization": { "const": "tenant-trust-evidence-json-v1" },
        "keyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:/-]{7,159}$"
        },
        "signedContentSha256": { "$ref": "../common.schema.json#/$defs/sha256" },
        "signatureBase64Url": {
          "type": "string",
          "description": "Unpadded base64url encoding of the 64-byte Ed25519 signature.",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "keyId",
        "signedContentSha256",
        "signatureBase64Url"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "tenantId",
    "subjectId",
    "sourceId",
    "evidenceType",
    "observedAt",
    "expiresAt",
    "sourceSequence",
    "nonce",
    "synthetic",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
