{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tenant-trust.local/contracts/policy/opa-decision-output.schema.json",
  "title": "OPA authorization decision output",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "const": "opa-decision-output-v1" },
    "decisionId": { "$ref": "../common.schema.json#/$defs/decisionId" },
    "requestId": { "$ref": "../common.schema.json#/$defs/requestId" },
    "correlationId": { "$ref": "../common.schema.json#/$defs/correlationId" },
    "tenantId": { "$ref": "../common.schema.json#/$defs/tenantId" },
    "subjectId": { "$ref": "../common.schema.json#/$defs/subjectId" },
    "outcome": { "enum": ["ALLOW", "STEP_UP", "DENY", "QUARANTINE"] },
    "reasonCodes": {
      "type": "array",
      "items": { "$ref": "../common.schema.json#/$defs/reasonCode" },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "evaluatedAt": { "$ref": "../common.schema.json#/$defs/rfc3339Utc" },
    "input": {
      "type": "object",
      "properties": {
        "contractId": { "const": "opa-decision-input-v1" },
        "hashSha256": { "$ref": "../common.schema.json#/$defs/sha256" }
      },
      "required": ["contractId", "hashSha256"],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "policyVersionId": { "$ref": "../common.schema.json#/$defs/policyVersionId" },
        "bundleVersion": { "type": "integer", "minimum": 1 },
        "bundleHashSha256": { "$ref": "../common.schema.json#/$defs/sha256" },
        "decisionPath": { "const": "tenant_trust/authorization/decision" }
      },
      "required": ["policyVersionId", "bundleVersion", "bundleHashSha256", "decisionPath"],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "certificateStatusVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "tenantVersion": { "type": "integer", "minimum": 1 },
        "subjectVersion": { "type": "integer", "minimum": 1 },
        "membershipVersion": { "type": "integer", "minimum": 1 },
        "trustTransitionId": {
          "oneOf": [
            { "$ref": "../common.schema.json#/$defs/trustTransitionId" },
            { "type": "null" }
          ]
        },
        "trustUpdateVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "trustConfigurationVersion": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      },
      "required": [
        "certificateStatusVersion",
        "tenantVersion",
        "subjectVersion",
        "membershipVersion",
        "trustTransitionId",
        "trustUpdateVersion",
        "trustConfigurationVersion"
      ],
      "additionalProperties": false
    },
    "obligations": {
      "type": "object",
      "properties": {
        "stepUp": {
          "oneOf": [
            { "$ref": "#/$defs/stepUpObligation" },
            { "type": "null" }
          ]
        },
        "quarantine": {
          "oneOf": [
            { "$ref": "#/$defs/quarantineObligation" },
            { "type": "null" }
          ]
        }
      },
      "required": ["stepUp", "quarantine"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "contractId",
    "decisionId",
    "requestId",
    "correlationId",
    "tenantId",
    "subjectId",
    "outcome",
    "reasonCodes",
    "evaluatedAt",
    "input",
    "policy",
    "state",
    "obligations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "ALLOW" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "object",
            "properties": {
              "stepUp": { "type": "null" },
              "quarantine": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "STEP_UP" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "object",
            "properties": {
              "stepUp": { "$ref": "#/$defs/stepUpObligation" },
              "quarantine": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "DENY" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "object",
            "properties": {
              "stepUp": { "type": "null" },
              "quarantine": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "QUARANTINE" } }, "required": ["outcome"] },
      "then": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "object",
            "properties": {
              "stepUp": { "type": "null" },
              "quarantine": { "$ref": "#/$defs/quarantineObligation" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stepUpObligation": {
      "type": "object",
      "properties": {
        "required": { "const": true },
        "binding": {
          "const": ["tenant", "subject", "action", "session"]
        },
        "maximumAgeSeconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      },
      "required": ["required", "binding", "maximumAgeSeconds"],
      "additionalProperties": false
    },
    "quarantineObligation": {
      "type": "object",
      "properties": {
        "required": { "const": true },
        "actionType": { "enum": ["restrict-access", "suspend-subject"] }
      },
      "required": ["required", "actionType"],
      "additionalProperties": false
    }
  }
}
