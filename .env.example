# Host ports bind to loopback so the development services are not exposed on the LAN.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
NATS_HOST_PORT=55022
STEP_CA_HOST_PORT=59000
OPA_HOST_PORT=58181
FABRIC_CA_ORDERER_HOST_PORT=17054
FABRIC_CA_PLATFORM_HOST_PORT=18054
FABRIC_CA_ALPHA_HOST_PORT=19054
FABRIC_CA_BETA_HOST_PORT=20054
FABRIC_ORDERER_HOST_PORT=17050
FABRIC_ORDERER_ADMIN_HOST_PORT=17053
FABRIC_PLATFORM_PEER_HOST_PORT=17051
FABRIC_ALPHA_PEER_HOST_PORT=18051
FABRIC_BETA_PEER_HOST_PORT=19051

# Stable names for normal development. Isolated verification overrides these values.
POSTGRES_VOLUME_NAME=tenant-trust-postgres-data
REDIS_VOLUME_NAME=tenant-trust-redis-data
NATS_VOLUME_NAME=tenant-trust-nats-data
STEP_CA_VOLUME_NAME=tenant-trust-step-ca-data
BACKEND_NETWORK_NAME=tenant-trust-backend
STEP_CA_PASSWORD_FILE=../../runtime/secrets/step-ca-password.txt
FABRIC_NETWORK_NAME=tenant-trust-fabric
FABRIC_ORDERER_VOLUME_NAME=tenant-trust-fabric-orderer-data
FABRIC_PLATFORM_PEER_VOLUME_NAME=tenant-trust-fabric-platform-peer-data
FABRIC_ALPHA_PEER_VOLUME_NAME=tenant-trust-fabric-alpha-peer-data
FABRIC_BETA_PEER_VOLUME_NAME=tenant-trust-fabric-beta-peer-data

POSTGRES_DB=tenant_trust
POSTGRES_USER=tenant_trust
POSTGRES_PASSWORD=replace-with-a-generated-local-secret
REDIS_PASSWORD=replace-with-a-generated-local-secret
NATS_USER=tenant_trust
NATS_PASSWORD=replace-with-a-generated-local-secret
NATS_TENANT_ALPHA_USER=tenant_alpha
NATS_TENANT_ALPHA_PASSWORD=replace-with-a-generated-local-secret
NATS_TENANT_BETA_USER=tenant_beta
NATS_TENANT_BETA_PASSWORD=replace-with-a-generated-local-secret
EVIDENCE_STORAGE_MASTER_KEY=replace-with-a-generated-32-byte-base64url-key
EVIDENCE_STORAGE_KEY_ID=local-evidence-v1

# Fabric CA bootstrap and enrollment secrets. infra:init generates distinct values in ignored .env.
FABRIC_CA_ORDERER_ADMIN_PASSWORD=replace-with-a-generated-local-secret
FABRIC_CA_PLATFORM_ADMIN_PASSWORD=replace-with-a-generated-local-secret
FABRIC_CA_ALPHA_ADMIN_PASSWORD=replace-with-a-generated-local-secret
FABRIC_CA_BETA_ADMIN_PASSWORD=replace-with-a-generated-local-secret
FABRIC_ORDERER_SECRET=replace-with-a-generated-local-secret
FABRIC_ORDERER_ORG_ADMIN_SECRET=replace-with-a-generated-local-secret
FABRIC_PLATFORM_PEER_SECRET=replace-with-a-generated-local-secret
FABRIC_PLATFORM_ORG_ADMIN_SECRET=replace-with-a-generated-local-secret
FABRIC_AUDIT_WRITER_SECRET=replace-with-a-generated-local-secret
FABRIC_AUDIT_VERIFIER_SECRET=replace-with-a-generated-local-secret
FABRIC_AUDIT_LISTENER_SECRET=replace-with-a-generated-local-secret
FABRIC_ALPHA_PEER_SECRET=replace-with-a-generated-local-secret
FABRIC_ALPHA_ORG_ADMIN_SECRET=replace-with-a-generated-local-secret
FABRIC_ALPHA_AUDITOR_SECRET=replace-with-a-generated-local-secret
FABRIC_BETA_PEER_SECRET=replace-with-a-generated-local-secret
FABRIC_BETA_ORG_ADMIN_SECRET=replace-with-a-generated-local-secret
FABRIC_BETA_AUDITOR_SECRET=replace-with-a-generated-local-secret

# Backend-only Fabric Gateway connection. Identity material remains under ignored runtime/fabric paths.
FABRIC_GATEWAY_ENDPOINT=127.0.0.1:17051
FABRIC_GATEWAY_SERVER_NAME=peer0.platform.audit.tenant-trust.test
FABRIC_GATEWAY_TOPOLOGY_PATH=config/fabric-topology.json
FABRIC_GATEWAY_TLS_ROOT_CERT_PATH=runtime/fabric/organizations/peerOrganizations/platform.audit.tenant-trust.test/peers/peer0.platform.audit.tenant-trust.test/tls/ca.crt
FABRIC_GATEWAY_WRITER_MSP_PATH=runtime/fabric/organizations/peerOrganizations/platform.audit.tenant-trust.test/users/audit-writer@platform.audit.tenant-trust.test/msp
FABRIC_GATEWAY_VERIFIER_MSP_PATH=runtime/fabric/organizations/peerOrganizations/platform.audit.tenant-trust.test/users/audit-verifier@platform.audit.tenant-trust.test/msp
FABRIC_GATEWAY_REQUEST_TIMEOUT_MS=10000

# Asynchronous PostgreSQL-to-Fabric audit delivery worker.
AUDIT_OUTBOX_WORKER_ID=audit-worker.local-1
AUDIT_OUTBOX_POLL_INTERVAL_MS=1000
