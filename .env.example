# Exact, reproducible service images. Update tags and digests together.
POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0
REDIS_IMAGE=redis:7.4.11-bookworm@sha256:71da9275c5f3fcb97d0fa0c8c5b36cc995327265420f17a04bfd544f458059f7
NATS_IMAGE=nats:2.14.6-alpine@sha256:ad7a43eb7e3337c3c38ce5d784d1461791f95f730f252d2b25eee699752a0ca3
STEP_CA_IMAGE=smallstep/step-ca:0.30.2@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
OPA_IMAGE=openpolicyagent/opa:1.20.2-debug@sha256:a055613b6107671605367eb7f23923883bb76a14dfaa53de2f068cd0c8e5484a

# Host ports bind to loopback so the development services are not exposed on the LAN.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
NATS_HOST_PORT=54222
STEP_CA_HOST_PORT=59000
OPA_HOST_PORT=58181

# Stable names for normal development. Isolated verification overrides these values.
POSTGRES_VOLUME_NAME=tenant-trust-postgres-data
REDIS_VOLUME_NAME=tenant-trust-redis-data
NATS_VOLUME_NAME=tenant-trust-nats-data
STEP_CA_VOLUME_NAME=tenant-trust-step-ca-data
BACKEND_NETWORK_NAME=tenant-trust-backend
STEP_CA_PASSWORD_FILE=../../runtime/secrets/step-ca-password.txt

POSTGRES_DB=tenant_trust
POSTGRES_USER=tenant_trust
POSTGRES_PASSWORD=replace-with-a-generated-local-secret
REDIS_PASSWORD=replace-with-a-generated-local-secret
NATS_USER=tenant_trust
NATS_PASSWORD=replace-with-a-generated-local-secret
NATS_TENANT_ALPHA_USER=tenant_alpha
NATS_TENANT_ALPHA_PASSWORD=replace-with-a-generated-local-secret
NATS_TENANT_BETA_USER=tenant_beta
NATS_TENANT_BETA_PASSWORD=replace-with-a-generated-local-secret
